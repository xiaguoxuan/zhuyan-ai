# Optional development-only paths. Never place API keys in VITE_* variables or this file.
# Use absolute paths appropriate for your machine when overriding the defaults.
# PI_CODING_AGENT_DIR=C:\path\to\isolated-pi-agent-config
# ZHUYAN_PI_CWD=C:\path\to\zhuyan-workspace-root
# PI_SOFT_FURNISH_WORKSPACE=C:\path\to\zhuyan-ai-projects

# Release audits require a rights-restricted reference root or an approved private
# hash manifest. Keep both outside Git and never commit reference image bytes.
# ZHUYAN_FORBIDDEN_REFERENCE_ROOT=C:\private\reference-library
# ZHUYAN_FORBIDDEN_REFERENCE_ROOTS=C:\private\reference-library
# ZHUYAN_FORBIDDEN_REFERENCE_HASH_MANIFESTS=C:\private\reference-library-sha256.json
# ZHUYAN_SENSITIVE_CONFIG_PATHS=C:\private\models.json;C:\private\auth.json
